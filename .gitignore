# --- Python & Jupyter Hygiene ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.virtual_documents
.env
venv/

# --- Notebook backups produced by patch scripts ---
*.ipynb.bak
*.bak

# --- HATI v1.5 Large Assets (Hosted on Hugging Face) ---
# We ignore these so they don't get pushed to GitHub.
# Users will fetch them using download_assets.py
*.tiff
*.tif
*.pt
*.pth
*.onnx

# --- Generated Data & Logs ---
# Ignore the output folders so we don't spam the repo with test runs
flight_segment_logs/
ground_segment_data/

# --- Heatmap cache files (regenerate via scripts/run_heatmap_apollo17.py) ---
*.npz
*.log

# Keep the folder structure, but ignore files inside (Optional)
# data/*
# !data/.gitkeep
# models/*
# !models/.gitkeep

# --- Raw PDS raster products (re-downloadable; one exceeds GitHub's 100MB limit) ---
# Fetch from the LROC/PDS node; small .xml/.LBL labels are kept for provenance.
*.IMG

# --- LaTeX build artifacts (keep .tex/.bib/.pdf) ---
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.out
*.run.xml
*.toc
*.synctex.gz
